# Example environment file for ip-sakti-sahayak
# Do not commit secrets or personal credentials.

# Backend server port
PORT=4000

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
# Supabase project URL (safe for browser)
VITE_SUPABASE_URL=

# Supabase publishable/anon key (safe for browser — never a service-role key)
VITE_SUPABASE_ANON_KEY=

# Backend API base URL consumed by the frontend
VITE_API_BASE_URL=http://localhost:4000

# Production app URL — used as the base for auth redirect URLs in production.
# Set this to your Vercel deployment URL (e.g. https://your-app.vercel.app).
# If not set, window.location.origin is used automatically (works for both local and production).
# VITE_APP_URL=

# ── Backend (server-side only — never exposed to the browser) ─────────────────
# Same Supabase project URL used server-side
SUPABASE_URL=

# Anon key used by server to call auth.getUser(token) — token validation only
SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS; keep strictly server-side; never in VITE_ vars
# SUPABASE_SERVICE_ROLE_KEY=

# ── AI ─────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=
